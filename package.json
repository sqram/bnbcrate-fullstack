{
  "name": "bnbcrate",
  "version": "1.0.0",
  "description": "bnbcrate website",
  "author": "sqram",
  "private": true,
  "scripts": {
    "dev": "export GOOGLE_APPLICATION_CREDENTIALS=gcloud-dev.json; NODE_ENV=dev backpack dev",
    "build": "run-p build:*",
    "start": "npm run build && npm run serve",
    "build:nuxt": "nuxt build",
    "build:server": "backpack build",
    "serve": "cross-env NODE_ENV=prod node build/main.js",
    "generate": "nuxt generate",
    "deploy-dev": "cp app.dev.yaml app.yaml; gcloud config set project bnbcrate-dev; export NODE_ENV=dev; gcloud app deploy",
    "deploy-prod": "cp app.prod.yaml app.yaml; gcloud config set project bnbcrate1; export NODE_ENV=prod; gcloud app deploy"
  },
  "dependencies": {
    "@google-cloud/datastore": "^4.0.0",
    "@nuxtjs/axios": "^5.5.3",
    "@nuxtjs/vuetify": "^0.5.5",
    "bcrypt": "^3.0.6",
    "cross-env": "^5.2.0",
    "kcors": "^2.2.2",
    "koa": "^2.6.2",
    "koa-body": "^4.1.0",
    "koa-jwt": "^3.5.1",
    "koa-router": "^7.4.0",
    "mailgun-js": "^0.22.0",
    "moment": "^2.24.0",
    "nuxt": "^2.8.1",
    "stripe": "^7.1.0",
    "validator": "^11.0.0",
    "vuetify-loader": "^1.2.1",
    "vuex-persistedstate": "^2.5.4"
  },
  "devDependencies": {
    "backpack-core": "^0.8.3",
    "dotenv": "^8.0.0",
    "nodemon": "^1.18.9",
    "npm-run-all": "^4.1.5",
    "stylus": "^0.54.5",
    "stylus-loader": "^3.0.2"
  }
}
